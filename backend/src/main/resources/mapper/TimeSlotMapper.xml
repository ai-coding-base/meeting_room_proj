<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.booking.mapper.TimeSlotMapper">

    <insert id="insertBatch" parameterType="java.util.List">
        INSERT INTO time_slots (room_id, slot_start, slot_end, booking_id, created_at)
        VALUES
        <foreach collection="slots" item="s" separator=",">
            (#{s.roomId}, #{s.slotStart}, #{s.slotEnd}, #{s.bookingId}, NOW())
        </foreach>
    </insert>

</mapper>
